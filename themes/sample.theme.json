{
    "type": "#theme#",
    "app": "com.cika.chatapp",
    "version": 1,
    "id": "my-theme",
    "name": "我的主题",
    "base": "dark",
    "description": "基于暗黑模式的自定义主题示例，复制本文件并按需修改变量即可生成新主题",
    "variables": {
        "--md-primary": "#4A9EFF",
        "--md-primary-variant": "#1565C0",
        "--md-primary-container": "rgba(74, 158, 255, 0.12)",
        "--md-on-primary": "#FFFFFF",
        "--md-secondary": "#03DAC6",
        "--md-background": "#121212",
        "--md-surface": "#1E1E1E",
        "--md-surface-1dp": "#1E1E1E",
        "--md-surface-2dp": "#232323",
        "--md-surface-4dp": "#282828",
        "--md-on-background": "#FFFFFF",
        "--md-on-surface": "#FFFFFF",
        "--md-on-surface-muted": "rgba(255, 255, 255, 0.60)",
        "--md-on-surface-dim": "rgba(255, 255, 255, 0.35)",
        "--md-outline": "rgba(255, 255, 255, 0.12)",
        "--md-error": "#CF6679",
        "--md-success": "#81C784",
        "--md-link": "#64B5F6",
        "--md-bubble-bg": "#232323",
        "--md-bubble-text": "#FFFFFF",
        "--md-bubble-own-bg": "#4A9EFF",
        "--md-appbar-bg": "#282828",
        "--md-chatbar-bg": "#282828",
        "--md-menu-bg": "#2F2F2F",
        "--md-outline-width": "1px",
        "--md-outline-style": "solid",
        "--md-sidebar-border": "#3A3A3A",
        "--md-avatar-0": "#4A9EFF",
        "--md-avatar-1": "#BA68C8",
        "--md-avatar-2": "#4DB6AC",
        "--md-avatar-3": "#4FC3F7",
        "--md-avatar-4": "#FF8A65",
        "--md-avatar-5": "#A1887F",
        "--md-avatar-6": "#90A4AE",
        "--md-avatar-7": "#F06292",
        "--md-focus-border": "2px solid var(--md-primary)",
        "--md-accent-border": "3px solid var(--md-primary)"
    }
}
